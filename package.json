{
  "name": "hub-jesusuzcategui",
  "version": "1.0.0",
  "description": "Hub Backend — Hexagonal Architecture base (Fastify + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "podman:run": "podman-compose -f docker-compose.local.yml up --build",
    "podman:down": "podman-compose -f docker-compose.local.yml down",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "argon2": "^0.44.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "pg": "^8.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  }
}
