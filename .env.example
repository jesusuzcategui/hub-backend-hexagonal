# Ports (host-side mappings)
HUB_PORT=
POSTGRES_PORT=
REDIS_PORT=

# App
PORT=3000
STATE_SECRET=
ALLOWED_REDIRECT_HOSTS=
APP_PUBLIC_URL=

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/dbname
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=2592000

# Cookies
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ePayco (Colombia) — direct HTTP integration, no SDK
EPAYCO_CUST_ID_CLIENTE=
EPAYCO_P_KEY=
EPAYCO_PUBLIC_KEY=
EPAYCO_VALIDATION_BASE_URL=https://api.epayco.co
EPAYCO_SUCCESS_URL=
EPAYCO_FAILURE_URL=
EPAYCO_PENDING_URL=
EPAYCO_CONFIRMATION_URL=

# WebDAV (Nextcloud) — manual bank transfer proof uploads
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# Umami — server-side purchase event dispatch
UMAMI_URL=
UMAMI_WEBSITE_ID=

# PayPal
