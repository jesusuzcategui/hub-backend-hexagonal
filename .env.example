# Server
PORT=3000

# Security — generate with: openssl rand -hex 32
STATE_SECRET=your_random_secret_key_64_chars_or_more

# Allowed redirect hosts (comma separated, no spaces)
ALLOWED_REDIRECT_HOSTS=yourdomain.com,anotherdomain.com

# PostgreSQL
DATABASE_URL=postgresql://hubuser:hubpass@localhost:5432/hubdb

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=2592000

# Cookies
COOKIE_SECURE=true
COOKIE_DOMAIN=hub.jesusuzcategui.com

# OAuth Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://hub.jesusuzcategui.com/auth/google/callback

# OAuth GitHub (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://hub.jesusuzcategui.com/auth/github/callback
